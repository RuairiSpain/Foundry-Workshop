# Copy to config.env and fill in. Every script sources this file.

# Subscription that hosts the hub. Attendees don't need access to the
# subscription itself — only to the resource group below.
export SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
export LOCATION="eastus2"

# The hub: one Foundry resource shared by every attendee's project.
export HUB_RESOURCE_GROUP="rg-cascadia-foundry-hub"
export HUB_ACCOUNT_NAME="cascadia-foundry-hub"
export ROUTER_DEPLOYMENT_NAME="cascadia-router"
export ROUTER_MODEL_NAME="model-router"
export ROUTER_MODEL_VERSION="2025-08-01"
export ROUTER_MODEL_FORMAT="OpenAI"

# Shared Cosmos DB account for Lab 20's per-attendee memory containers.
export COSMOS_ACCOUNT_NAME="cascadia-workshop-memory"
export COSMOS_DATABASE_NAME="workshop-memory"

# Shared AI Gateway for Lab 30's per-attendee keys.
export APIM_NAME="cascadia-ai-gateway"
export APIM_PUBLISHER_EMAIL="platform-team@example.com"
export APIM_PUBLISHER_NAME="Cascadia Outfitters Platform Team"
export APIM_SKU="Consumption"
