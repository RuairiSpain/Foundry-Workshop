# Copy to .env (or export these directly) before running the benchmark
# against a real Foundry project. Never commit a real .env file — it's
# already covered by the repo's top-level .gitignore pattern for .env,
# but double-check before committing anything under deepseek/.

# Required. Your Foundry project's inference endpoint.
AZURE_FOUNDRY_ENDPOINT=https://<your-project>.services.ai.azure.com

# Optional. Defaults to a recent preview API version if unset — pin
# this once you've confirmed which version your project supports.
AZURE_FOUNDRY_API_VERSION=2026-01-01-preview

# Required only for `--azure-monitor` / `reconcile` — these identify
# the Foundry resource whose metrics to query.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_FOUNDRY_RESOURCE_NAME=

# Optional. Used only for a note in output — Azure Monitor metrics
# come back per-resource, not per-region.
AZURE_FOUNDRY_REGION=

# Optional. Not currently used directly by this project (Azure Monitor
# querying goes through azure-mgmt-monitor, not Log Analytics), kept
# for parity with the spec's suggested environment variables in case a
# Log Analytics-based query is added later.
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# Optional. Enables Application Insights export for the
# `benchmark.model_request` OpenTelemetry spans. Omit to run with
# telemetry as a no-op (spans are still created against the default
# no-op tracer provider; nothing is exported anywhere).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional. Defaults to a UTC timestamp if unset.
BENCHMARK_RUN_ID=

# --- Authentication --------------------------------------------------------
# Default: DefaultAzureCredential (Entra ID) — covers managed identity
# when running in Azure and Azure CLI credentials for local
# development, automatically. Leave both of the following unset unless
# you specifically need the API-key fallback.

# Optional, explicit opt-in required. Set to "true" only if you must
# use an API key instead of Entra ID.
AZURE_FOUNDRY_USE_API_KEY=false

# Required only when AZURE_FOUNDRY_USE_API_KEY=true.
AZURE_FOUNDRY_API_KEY=
